<brls:AppletFrame
        id="video/detail/frame"
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            width="100%"
            height="100%"
            grow="1.0"
            axis="column">

        <VideoView
                id="video"
                focusable="true"
                grow="1"
                width="100%"
                height="100%"/>

        <ButtonClose
                positionType="absolute"
                positionTop="2"
                positionRight="2"/>

    </brls:Box>

</brls:AppletFrame>
